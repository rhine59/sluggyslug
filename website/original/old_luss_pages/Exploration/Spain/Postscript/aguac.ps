userdict /IslandDrawDict 300 dict dup begin put

/bdef	{bind def} bind def
/E	{exch} bdef
/FF	{findfont} bdef
/MF	{makefont} bdef
/RO	{rotate} bdef
/SC	{scale} bdef
/SF	{setfont} bdef
/SG	{setgray} bdef
/TR	{translate} bdef
/bp	{lj lw rgb} bdef
/bpbw	{lj lw setgray} bdef
