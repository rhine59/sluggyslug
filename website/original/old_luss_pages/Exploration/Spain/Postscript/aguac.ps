/extend_font {  % stack: fontname newfontname
exch dup (ZapfDingbats) eq
{ cvn exch cvn extended_Zapf ReencodeSmall }
{ dup (Symbol) eq
{ cvn exch cvn extended_Symbol ReencodeSmall }
