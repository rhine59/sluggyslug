cavename = Jingling Pot
permit = No
description = A single tree over a pretty open shaft approximately 75
description = metres North West Of The Turbary Road, Opposite the first
description = dogleg in the kingsdale beck, north of braida garth farm.
description = Or Follow the turbary road north along West Kingsdale for
description = approx 400 metres past Rowten Pot. Then look for the lone
description = tree 75 metres North West. <P>
description = A Y-hang from the trees overhanging the shaft is a common entry method,
description = two slings might be needed. Several spits exist in the rock of the
description = stream adjacent to the pot and these can be used as a traverse line and
description = backups when rigging. <P>
description = This main pitch can be descended to the floor some 45 metres below or
description = approx 9 metres down there is an alternative route called the
description = <EM>Lateral Cleft</EM>
description = Swing accross the shaft by pushing on the opposite wall into a narrow
description = opening. There is a point to re-belay the rope before a short traverse
description = and the second (7m) pitch.
description = <P><EM>More To Follow...</EM>
grade = Three
grade = Any
