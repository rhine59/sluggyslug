cavealtitude = 410
cavedepth = 113
cavelength = Combined Total 580
cavename = Long Kin East Cave and Pot
permit = Cant Remember
permitfrom = 
description = There are four main entrances to this cave. The top
description = entrance is found taking a stream in an area of limestone
description = pavement. This can be easily followed past the other entrances
description = The second entrance is very close to this and
description = not worth mentioning, except for completeness. The third
description = entrance is a pot, which whilst being climbable is not a
description = pleasant way into the cave. The fourth entrance is again a
description = pot, and provides a reasonable way into the cave.
description = Drop down about 18ft in total to the streamway, and follow
description = the stream along some a rift like passage to the top of the
description = first pitch. This is a series of three climbs, which require
description = one 25ft length of ladder in wet weather, but can be
description = free climbed in dry weather(Although I haven't).
description = Followed shortly after this is a second pitch, of height about
description = 20ft. After this, and round a corner, there are a couple of
description = pools, and cascades. From one such cascade, with a drop of about
description = 3ft a traverse off at that height leads to a traverse around
description = the bit Rift Pot. Following the streamway leads to a short
description = 15ft? pitch, and then the main drop into Rift Pot.
description = The traverse round the side of the Pot, leads to a rock
description = bridge, which after crossing(20m? handline) leads to a 30ft
description = pitch onto a ledge, with a further 190ft pitch which connects 
description = with the route in from Rift Pot.
grade = One
grade = Any
gridreference = 762731 & 762729
location = The Allotment
location = Any

